\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces 学习率预热和余弦退火的学习率调度示意图。前$T_{\text  {warm}}$个epoch内学习率从$0$线性升至$\eta _{\max }$，随后按余弦曲线平滑衰减至$\eta _{\min }$，两段在$t=T_{\text  {warm}}$处连续衔接。}}{31}{figure.caption.27}\protected@file@percent }
