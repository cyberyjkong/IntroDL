\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces 病态曲率损失面（左）及其上的SGD参数优化轨迹（右）。左图等高线围成狭窄且弯曲的谷，垂直谷方向的曲率与梯度远大于沿谷方向；右图中SGD的更新步因此在谷壁之间来回横跳，难以沿谷方向向极小值点（白色圆圈）有效推进。}}{34}{figure.caption.29}\protected@file@percent }
\newlabel{fig:ill_conditioned}{{3.9}{34}{病态曲率损失面（左）及其上的SGD参数优化轨迹（右）。左图等高线围成狭窄且弯曲的谷，垂直谷方向的曲率与梯度远大于沿谷方向；右图中SGD的更新步因此在谷壁之间来回横跳，难以沿谷方向向极小值点（白色圆圈）有效推进。}{figure.caption.29}{}}
\newlabel{fig:ill_conditioned@cref}{{[figure][9][3]3.9}{[1][34][]34}{}{}{}}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3.10}{\ignorespaces 病态曲率损失面（左）与使用动量法的参数优化轨迹（右）。在窄而弯的谷地形上，动量法通过速度项累积历史梯度，抵消横向震荡并叠加沿谷推进；轨迹仅在初期轻微过冲，随后即沿谷底平滑收敛至极小值点（白色圆圈）。}}{36}{figure.caption.30}\protected@file@percent }
\newlabel{fig:ill_conditioned_sovled}{{3.10}{36}{病态曲率损失面（左）与使用动量法的参数优化轨迹（右）。在窄而弯的谷地形上，动量法通过速度项累积历史梯度，抵消横向震荡并叠加沿谷推进；轨迹仅在初期轻微过冲，随后即沿谷底平滑收敛至极小值点（白色圆圈）。}{figure.caption.30}{}}
\newlabel{fig:ill_conditioned_sovled@cref}{{[figure][10][3]3.10}{[1][35][]36}{}{}{}}
