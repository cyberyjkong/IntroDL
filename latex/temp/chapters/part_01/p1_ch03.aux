\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {3.1}学习率}{28}{section.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces 学习率过大与过小的对比。左图学习率过大，参数在损失曲线两侧震荡甚至发散，无法收敛；右图学习率过小，参数步长极小，向局部最小值的收敛极其缓慢。}}{28}{figure.caption.23}\protected@file@percent }
\newlabel{fig:learning_rate_bad}{{3.3}{28}{学习率过大与过小的对比。左图学习率过大，参数在损失曲线两侧震荡甚至发散，无法收敛；右图学习率过小，参数步长极小，向局部最小值的收敛极其缓慢。}{figure.caption.23}{}}
\newlabel{fig:learning_rate_bad@cref}{{[figure][3][3]3.3}{[1][28][]28}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces 经典马鞍面$z = x^2 - y^2$。曲面沿$x$轴方向向上弯曲、沿$y$轴方向向下弯曲，形似马鞍。红点为鞍点：该处梯度为零，既非局部极小值也非局部极大值。}}{29}{figure.caption.24}\protected@file@percent }
\newlabel{fig:saddle_landscape}{{3.4}{29}{经典马鞍面$z = x^2 - y^2$。曲面沿$x$轴方向向上弯曲、沿$y$轴方向向下弯曲，形似马鞍。红点为鞍点：该处梯度为零，既非局部极小值也非局部极大值。}{figure.caption.24}{}}
\newlabel{fig:saddle_landscape@cref}{{[figure][4][3]3.4}{[1][28][]29}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces 合理设置学习率下的梯度下降轨迹。在远离全局最小值时采用较大学习率，参数得以快速下降并越过较浅的局部极小值（local minimum）；当接近全局最小值时逐渐减小学习率，避免在谷底附近震荡，最终平稳、精确地收敛至全局最小值（global minimum）。}}{29}{figure.caption.25}\protected@file@percent }
\newlabel{fig:learning_rate_good}{{3.5}{29}{合理设置学习率下的梯度下降轨迹。在远离全局最小值时采用较大学习率，参数得以快速下降并越过较浅的局部极小值（local minimum）；当接近全局最小值时逐渐减小学习率，避免在谷底附近震荡，最终平稳、精确地收敛至全局最小值（global minimum）。}{figure.caption.25}{}}
\newlabel{fig:learning_rate_good@cref}{{[figure][5][3]3.5}{[1][29][]29}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces 余弦函数$y=\cos (x)$在区间$[0,\pi ]$上的图像。曲线自$(0,1)$单调递减，于$x=\pi /2$处过零，最终到达$(\pi ,-1)$，且两端斜率为零。}}{30}{figure.caption.26}\protected@file@percent }
\newlabel{fig:cosine}{{3.6}{30}{余弦函数$y=\cos (x)$在区间$[0,\pi ]$上的图像。曲线自$(0,1)$单调递减，于$x=\pi /2$处过零，最终到达$(\pi ,-1)$，且两端斜率为零。}{figure.caption.26}{}}
\newlabel{fig:cosine@cref}{{[figure][6][3]3.6}{[1][30][]30}{}{}{}}
