\@writefile{toc}{\contentsline {section}{\numberline {7.2}VGG}{93}{section.7.2}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces 感受野的堆叠效应。红、蓝框链展示末端单个位置（右端粉格）的感受野逐层向回映射：每回退一层，覆盖区域就扩大一圈。两层$3\times 3$卷积堆叠后覆盖原始输入的$5\times 5$区域（上排），三层堆叠后扩大为$7\times 7$（下排），即堆叠小卷积核可获得与大卷积核相同的有效感受野。}}{94}{figure.caption.64}\protected@file@percent }
\newlabel{fig:vgg_receptive_field}{{7.4}{94}{感受野的堆叠效应。红、蓝框链展示末端单个位置（右端粉格）的感受野逐层向回映射：每回退一层，覆盖区域就扩大一圈。两层$3\times 3$卷积堆叠后覆盖原始输入的$5\times 5$区域（上排），三层堆叠后扩大为$7\times 7$（下排），即堆叠小卷积核可获得与大卷积核相同的有效感受野。}{figure.caption.64}{}}
\newlabel{fig:vgg_receptive_field@cref}{{[figure][4][7]7.4}{[1][94][]94}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces VGG-16网络架构。13个$3\times 3$卷积（后接ReLU）与5个最大池化层交替堆叠，通道数逐级翻倍（64、128、256、512），空间尺寸随每次池化减半（224、112、56、28、14），最终压缩为$7\times 7\times 512$；末端经两个4096维全连接层与Softmax输出类别概率。}}{95}{figure.caption.65}\protected@file@percent }
\newlabel{fig:vggnet}{{7.5}{95}{VGG-16网络架构。13个$3\times 3$卷积（后接ReLU）与5个最大池化层交替堆叠，通道数逐级翻倍（64、128、256、512），空间尺寸随每次池化减半（224、112、56、28、14），最终压缩为$7\times 7\times 512$；末端经两个4096维全连接层与Softmax输出类别概率。}{figure.caption.65}{}}
\newlabel{fig:vggnet@cref}{{[figure][5][7]7.5}{[1][95][]95}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {7.3}GoogLeNet}{96}{section.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces Inception模块基本结构。同一张输入特征图同时送入四条并行分支：$1\times 1$卷积、$3\times 3$卷积、$5\times 5$卷积与$3\times 3$最大池化；四条分支的输出保持相同的空间尺寸，再沿通道维度拼接（concatenate），合并为一张新的输出特征图。}}{96}{figure.caption.66}\protected@file@percent }
\newlabel{fig:inception}{{7.6}{96}{Inception模块基本结构。同一张输入特征图同时送入四条并行分支：$1\times 1$卷积、$3\times 3$卷积、$5\times 5$卷积与$3\times 3$最大池化；四条分支的输出保持相同的空间尺寸，再沿通道维度拼接（concatenate），合并为一张新的输出特征图。}{figure.caption.66}{}}
\newlabel{fig:inception@cref}{{[figure][6][7]7.6}{[1][96][]96}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces $1\times 1$卷积示意图。卷积核的空间尺寸仅为$1\times 1$（图中红框柱），不观察空间邻域，只在每个空间位置对全部$M$个通道做加权求和，完成跨通道的信息组合；输出特征图的空间尺寸保持$H\times W$不变，仅通道数由$M$变为$N$。}}{97}{figure.caption.67}\protected@file@percent }
\newlabel{fig:11_convolution}{{7.7}{97}{$1\times 1$卷积示意图。卷积核的空间尺寸仅为$1\times 1$（图中红框柱），不观察空间邻域，只在每个空间位置对全部$M$个通道做加权求和，完成跨通道的信息组合；输出特征图的空间尺寸保持$H\times W$不变，仅通道数由$M$变为$N$。}{figure.caption.67}{}}
\newlabel{fig:11_convolution@cref}{{[figure][7][7]7.7}{[1][97][]97}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7.8}{\ignorespaces Inception模块完整结构。与图\ref {fig:inception}相比，$3\times 3$和$5\times 5$分支前各加$1\times 1$卷积压缩通道，$3\times 3$最大池化后也加$1\times 1$卷积控制输出通道；四分支输出沿通道拼接。该设计保持多尺度并行特征提取的同时，显著降低了参数量与计算量，且$1\times 1$卷积兼具跨通道融合与非线性变换作用。}}{98}{figure.caption.68}\protected@file@percent }
\newlabel{fig:inception_module}{{7.8}{98}{Inception模块完整结构。与图\ref {fig:inception}相比，$3\times 3$和$5\times 5$分支前各加$1\times 1$卷积压缩通道，$3\times 3$最大池化后也加$1\times 1$卷积控制输出通道；四分支输出沿通道拼接。该设计保持多尺度并行特征提取的同时，显著降低了参数量与计算量，且$1\times 1$卷积兼具跨通道融合与非线性变换作用。}{figure.caption.68}{}}
\newlabel{fig:inception_module@cref}{{[figure][8][7]7.8}{[1][98][]98}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7.9}{\ignorespaces GoogLeNet整体结构。网络堆叠9个Inception模块，并在适当位置插入步长为2的最大池化，使分辨率按$224\to 112\to 56\to 28\to 14\to 7$降低、通道数增加；中部引入两个辅助分类器缓解梯度消失，末端用全局平均池化取代全连接层，将$7\times 7\times 1024$特征图直接送入softmax分类。}}{99}{figure.caption.69}\protected@file@percent }
\newlabel{fig:googlenet}{{7.9}{99}{GoogLeNet整体结构。网络堆叠9个Inception模块，并在适当位置插入步长为2的最大池化，使分辨率按$224\to 112\to 56\to 28\to 14\to 7$降低、通道数增加；中部引入两个辅助分类器缓解梯度消失，末端用全局平均池化取代全连接层，将$7\times 7\times 1024$特征图直接送入softmax分类。}{figure.caption.69}{}}
\newlabel{fig:googlenet@cref}{{[figure][9][7]7.9}{[1][99][]99}{}{}{}}
