\@writefile{toc}{\contentsline {section}{\numberline {7.1}AlexNet}{88}{section.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces AlexNet网络架构（原始论文的双GPU画法）。上下两排为两张GPU上并行计算的卷积分支，跨分支的连线表示GPU之间的特征传递，末端汇合到全连接层并输出1000个类别。}}{88}{figure.caption.61}\protected@file@percent }
\newlabel{fig:alexnet}{{7.1}{88}{AlexNet网络架构（原始论文的双GPU画法）。上下两排为两张GPU上并行计算的卷积分支，跨分支的连线表示GPU之间的特征传递，末端汇合到全连接层并输出1000个类别。}{figure.caption.61}{}}
\newlabel{fig:alexnet@cref}{{[figure][1][7]7.1}{[1][88][]88}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces AlexNet网络架构（单GPU）。将双GPU分支合并为单条计算链：$224\times 224\times 3$输入经5个卷积层与3个最大池化层逐层提取特征，末端由4096、4096两个全连接层映射到1000类输出。}}{89}{figure.caption.62}\protected@file@percent }
\newlabel{fig:alexnet_single_gpu}{{7.2}{89}{AlexNet网络架构（单GPU）。将双GPU分支合并为单条计算链：$224\times 224\times 3$输入经5个卷积层与3个最大池化层逐层提取特征，末端由4096、4096两个全连接层映射到1000类输出。}{figure.caption.62}{}}
\newlabel{fig:alexnet_single_gpu@cref}{{[figure][2][7]7.2}{[1][89][]89}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces AlexNet卷积层与池化层的重绘。改用与LeNet一致的特征图堆叠画法，逐层标出通道数与空间尺寸，便于直观对照各层的输入输出形状。}}{89}{figure.caption.63}\protected@file@percent }
\newlabel{fig:alexnet_single}{{7.3}{89}{AlexNet卷积层与池化层的重绘。改用与LeNet一致的特征图堆叠画法，逐层标出通道数与空间尺寸，便于直观对照各层的输入输出形状。}{figure.caption.63}{}}
\newlabel{fig:alexnet_single@cref}{{[figure][3][7]7.3}{[1][89][]89}{}{}{}}
