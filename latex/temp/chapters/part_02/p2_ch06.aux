\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {10.8}{\ignorespaces 空洞空间金字塔池化（ASPP）。输入特征图并行经过五条分支：$1\times 1$卷积、空洞率$r=1,2,3$的$3\times 3$空洞卷积，以及全局平均池化（将整图压缩为$1\times 1$全局表示再上采样回原尺寸）；各分支分别观察不同范围的上下文信息，输出沿通道维拼接后经$1\times 1$卷积（BN+ReLU）融合，得到最终输出。}}{131}{figure.caption.95}\protected@file@percent }
\newlabel{fig:aspp}{{10.8}{131}{空洞空间金字塔池化（ASPP）。输入特征图并行经过五条分支：$1\times 1$卷积、空洞率$r=1,2,3$的$3\times 3$空洞卷积，以及全局平均池化（将整图压缩为$1\times 1$全局表示再上采样回原尺寸）；各分支分别观察不同范围的上下文信息，输出沿通道维拼接后经$1\times 1$卷积（BN+ReLU）融合，得到最终输出。}{figure.caption.95}{}}
\newlabel{fig:aspp@cref}{{[figure][8][10]10.8}{[1][131][]131}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10.4}DeepLab}{131}{section.10.4}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {10.9}{\ignorespaces DeepLabV3+整体架构。Encoder：骨干网络提取浅层特征（$\tfrac  {H}{4}\times \tfrac  {W}{4}\times 256$）与深层特征（$\tfrac  {H}{16}\times \tfrac  {W}{16}\times 2048$），深层特征经ASPP模块获得多尺度上下文信息。Decoder：ASPP输出先$\times 4$上采样，与经$1\times 1$卷积压缩至48通道的浅层特征沿通道拼接，再经$3\times 3$卷积精炼、$\times 4$上采样，得到最终逐像素预测（$H\times W\times K$）。}}{132}{figure.caption.96}\protected@file@percent }
\newlabel{fig:deeplab}{{10.9}{132}{DeepLabV3+整体架构。Encoder：骨干网络提取浅层特征（$\tfrac {H}{4}\times \tfrac {W}{4}\times 256$）与深层特征（$\tfrac {H}{16}\times \tfrac {W}{16}\times 2048$），深层特征经ASPP模块获得多尺度上下文信息。Decoder：ASPP输出先$\times 4$上采样，与经$1\times 1$卷积压缩至48通道的浅层特征沿通道拼接，再经$3\times 3$卷积精炼、$\times 4$上采样，得到最终逐像素预测（$H\times W\times K$）。}{figure.caption.96}{}}
\newlabel{fig:deeplab@cref}{{[figure][9][10]10.9}{[1][131][]132}{}{}{}}
