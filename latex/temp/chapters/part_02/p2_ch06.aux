\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1.1}$1\times 1$卷积}{123}{subsection.10.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.3}{\ignorespaces 卷积池化网络。输入$H\times W\times 3$图像经过四次“卷积+池化”，空间尺寸依次缩小为原来的$1/2$、$1/4$、$1/8$和$1/16$，同时通道数逐步增加为$C_1$、$C_2$、$C_3$和$C_4$，得到具有较强语义信息的深层特征。}}{123}{figure.caption.90}\protected@file@percent }
\newlabel{fig:conv_pool}{{10.3}{123}{卷积池化网络。输入$H\times W\times 3$图像经过四次“卷积+池化”，空间尺寸依次缩小为原来的$1/2$、$1/4$、$1/8$和$1/16$，同时通道数逐步增加为$C_1$、$C_2$、$C_3$和$C_4$，得到具有较强语义信息的深层特征。}{figure.caption.90}{}}
\newlabel{fig:conv_pool@cref}{{[figure][3][10]10.3}{[1][123][]123}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1.2}上采样与转置卷积}{124}{subsection.10.1.2}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {10.4}{\ignorespaces 转置卷积的具体例子（输入$2\times 2$、核$2\times 2$）。每个输入元素（彩色格）与核$K$相乘生成同色的$2\times 2$响应块，再按步长决定的偏移放置并相加。上排步长1：响应块逐格错位、彼此重叠，重叠位置累加（如中心15），得$3\times 3$输出；下排步长2：响应块互不重叠、直接拼接，得$4\times 4$输出。}}{125}{figure.caption.91}\protected@file@percent }
\newlabel{fig:transpose_convolution}{{10.4}{125}{转置卷积的具体例子（输入$2\times 2$、核$2\times 2$）。每个输入元素（彩色格）与核$K$相乘生成同色的$2\times 2$响应块，再按步长决定的偏移放置并相加。上排步长1：响应块逐格错位、彼此重叠，重叠位置累加（如中心15），得$3\times 3$输出；下排步长2：响应块互不重叠、直接拼接，得$4\times 4$输出。}{figure.caption.91}{}}
\newlabel{fig:transpose_convolution@cref}{{[figure][4][10]10.4}{[1][125][]125}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1.3}跳跃连接}{126}{subsection.10.1.3}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {10.5}{\ignorespaces 语义分割网络。下采样段经四层“卷积+池化”将分辨率逐次降至$1/16$（$\tfrac  {H}{16}\times \tfrac  {W}{16}\times C_4$），再由$1\times 1$卷积调整为$K$个通道；上采样段经四层转置卷积将分辨率逐次翻倍，恢复至$H\times W$，输出逐像素的$K$类预测。}}{127}{figure.caption.92}\protected@file@percent }
\newlabel{fig:conv_pool_transpose}{{10.5}{127}{语义分割网络。下采样段经四层“卷积+池化”将分辨率逐次降至$1/16$（$\tfrac {H}{16}\times \tfrac {W}{16}\times C_4$），再由$1\times 1$卷积调整为$K$个通道；上采样段经四层转置卷积将分辨率逐次翻倍，恢复至$H\times W$，输出逐像素的$K$类预测。}{figure.caption.92}{}}
\newlabel{fig:conv_pool_transpose@cref}{{[figure][5][10]10.5}{[1][127][]127}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.6}{\ignorespaces 全卷积网络。相比\cref  {fig:conv_pool_transpose}增加了跳跃连接（虚线）：将下采样段中保留空间细节的浅层特征（$1/2$、$1/4$、$1/8$分辨率）接入上采样段的同分辨率特征图进行融合，补偿下采样丢失的空间信息；网络从输入到输出不含全连接层，始终以特征图形式计算。}}{127}{figure.caption.93}\protected@file@percent }
\newlabel{fig:full_convolution_network}{{10.6}{127}{全卷积网络。相比\cref {fig:conv_pool_transpose}增加了跳跃连接（虚线）：将下采样段中保留空间细节的浅层特征（$1/2$、$1/4$、$1/8$分辨率）接入上采样段的同分辨率特征图进行融合，补偿下采样丢失的空间信息；网络从输入到输出不含全连接层，始终以特征图形式计算。}{figure.caption.93}{}}
\newlabel{fig:full_convolution_network@cref}{{[figure][6][10]10.6}{[1][127][]127}{}{}{}}
