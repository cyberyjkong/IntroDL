\@writefile{lof}{\contentsline {figure}{\numberline {10.1}{\ignorespaces 用于图像分类的卷积神经网络。输入$H\times W\times 3$图像经多轮“卷积+池化”逐步提取低、中、高层特征，再展平送入全连接层，最终由Softmax输出各类别概率。}}{122}{figure.caption.88}\protected@file@percent }
\newlabel{fig:cnn_for_classification}{{10.1}{122}{用于图像分类的卷积神经网络。输入$H\times W\times 3$图像经多轮“卷积+池化”逐步提取低、中、高层特征，再展平送入全连接层，最终由Softmax输出各类别概率。}{figure.caption.88}{}}
\newlabel{fig:cnn_for_classification@cref}{{[figure][1][10]10.1}{[1][122][]122}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.2}{\ignorespaces 语义分割任务。根据图像内容，将输入$H\times W\times 3$图像划分为语义不同的区域：本例中模型提取猫所在区域并与背景分离，猫轮廓内标为前景（红）、其余标为背景。}}{122}{figure.caption.89}\protected@file@percent }
\newlabel{fig:segment}{{10.2}{122}{语义分割任务。根据图像内容，将输入$H\times W\times 3$图像划分为语义不同的区域：本例中模型提取猫所在区域并与背景分离，猫轮廓内标为前景（红）、其余标为背景。}{figure.caption.89}{}}
\newlabel{fig:segment@cref}{{[figure][2][10]10.2}{[1][122][]122}{}{}{}}
