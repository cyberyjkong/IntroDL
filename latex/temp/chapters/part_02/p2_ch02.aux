\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {6.2}反向传播}{74}{section.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2.1}池化层的反向传播}{74}{subsection.6.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces 最大池化的反向传播。前向传播将$12\times 6\times 6$的特征图通过$2\times 2$、步长为$2$的最大池化得到$12\times 3\times 3$的特征图；反向传播时，$12\times 3\times 3$的梯度根据前向传播时记录的最大值位置重新分配，恢复为$12\times 6\times 6$的梯度。}}{74}{figure.caption.56}\protected@file@percent }
\newlabel{fig:bp_pooling}{{6.2}{74}{最大池化的反向传播。前向传播将$12\times 6\times 6$的特征图通过$2\times 2$、步长为$2$的最大池化得到$12\times 3\times 3$的特征图；反向传播时，$12\times 3\times 3$的梯度根据前向传播时记录的最大值位置重新分配，恢复为$12\times 6\times 6$的梯度。}{figure.caption.56}{}}
\newlabel{fig:bp_pooling@cref}{{[figure][2][6]6.2}{[1][74][]74}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2.2}卷积层的反向传播}{75}{subsection.6.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces 卷积层Conv2的反向传播。来自Pool2的梯度同时用于计算卷积核的权重梯度、偏置梯度以及输入梯度：将梯度与对应输入逐位置相乘并累加，得到权重梯度；对空间位置上的梯度求和，得到偏置梯度；将梯度与对应卷积核权重进行加权并累加，得到输入梯度，并继续传回Pool1。}}{75}{figure.caption.57}\protected@file@percent }
\newlabel{fig:bp_convolution}{{6.3}{75}{卷积层Conv2的反向传播。来自Pool2的梯度同时用于计算卷积核的权重梯度、偏置梯度以及输入梯度：将梯度与对应输入逐位置相乘并累加，得到权重梯度；对空间位置上的梯度求和，得到偏置梯度；将梯度与对应卷积核权重进行加权并累加，得到输入梯度，并继续传回Pool1。}{figure.caption.57}{}}
\newlabel{fig:bp_convolution@cref}{{[figure][3][6]6.3}{[1][75][]75}{}{}{}}
