\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {9.10}{\ignorespaces Squeeze-and-Excitation模块。Squeeze对每个通道做全局平均池化，将$H\times W\times C$特征图压缩为$1\times 1\times C$的通道描述；Excitation经全连接生成$C$个通道权重（彩色条）；最后权重与原始特征图逐通道相乘（$\ast $），重标定各通道强度，输出仍为$H\times W\times C$。}}{120}{figure.caption.87}\protected@file@percent }
\newlabel{fig:se}{{9.10}{120}{Squeeze-and-Excitation模块。Squeeze对每个通道做全局平均池化，将$H\times W\times C$特征图压缩为$1\times 1\times C$的通道描述；Excitation经全连接生成$C$个通道权重（彩色条）；最后权重与原始特征图逐通道相乘（$\ast $），重标定各通道强度，输出仍为$H\times W\times C$。}{figure.caption.87}{}}
\newlabel{fig:se@cref}{{[figure][10][9]9.10}{[1][120][]120}{}{}{}}
