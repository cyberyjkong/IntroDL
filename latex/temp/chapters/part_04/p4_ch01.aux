\@writefile{lof}{\contentsline {figure}{\numberline {20.1}{\ignorespaces Seq2Seq模型中基于RNN的自回归生成过程。解码器以编码器输出的上下文向量$c$初始化隐藏状态，从$\langle \mathrm  {SOS}\rangle $开始逐步预测token。橙色虚线表示将预测结果作为下一时间步的输入，直到生成$\langle \mathrm  {EOS}\rangle $。}}{279}{figure.caption.178}\protected@file@percent }
\newlabel{fig:autoregressive}{{20.1}{279}{Seq2Seq模型中基于RNN的自回归生成过程。解码器以编码器输出的上下文向量$c$初始化隐藏状态，从$\langle \mathrm {SOS}\rangle $开始逐步预测token。橙色虚线表示将预测结果作为下一时间步的输入，直到生成$\langle \mathrm {EOS}\rangle $。}{figure.caption.178}{}}
\newlabel{fig:autoregressive@cref}{{[figure][1][20]20.1}{[1][279][]279}{}{}{}}
