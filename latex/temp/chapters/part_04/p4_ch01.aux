\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.2}{\ignorespaces 文本联合概率的链式分解。以“请／先／登录／账号”为例，绿色表示已有历史token，橙色表示当前预测的token。随着历史逐步增长，各项条件概率相乘得到整个序列的联合概率。}}{282}{figure.caption.179}\protected@file@percent }
\newlabel{fig:chain_rule}{{20.2}{282}{文本联合概率的链式分解。以“请／先／登录／账号”为例，绿色表示已有历史token，橙色表示当前预测的token。随着历史逐步增长，各项条件概率相乘得到整个序列的联合概率。}{figure.caption.179}{}}
\newlabel{fig:chain_rule@cref}{{[figure][2][20]20.2}{[1][282][]282}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {20.1.1}N-gram}{282}{subsection.20.1.1}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.3}{\ignorespaces 不同N-gram模型的历史上下文范围。以预测“账号”为例，Bigram仅考虑“登录”，Trigram考虑“先／登录”，4-gram考虑“请／先／登录”。绿色表示使用的历史token，灰色表示忽略的历史，橙色表示当前预测的token。}}{283}{figure.caption.180}\protected@file@percent }
\newlabel{fig:ngram_window}{{20.3}{283}{不同N-gram模型的历史上下文范围。以预测“账号”为例，Bigram仅考虑“登录”，Trigram考虑“先／登录”，4-gram考虑“请／先／登录”。绿色表示使用的历史token，灰色表示忽略的历史，橙色表示当前预测的token。}{figure.caption.180}{}}
\newlabel{fig:ngram_window@cref}{{[figure][3][20]20.3}{[1][283][]283}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {20.1.2}词频估计}{283}{subsection.20.1.2}\protected@file@percent }
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.4}{\ignorespaces Trigram模型基于词频估计条件概率。以“请／先”为历史，其出现100次，其中后接“登录”65次、后接“登陆”3次，对应概率分别为0.65和0.03；“先／登录”后接“账号”的概率为0.8。图中数据均为假设值。}}{285}{figure.caption.181}\protected@file@percent }
\newlabel{fig:ngram_count}{{20.4}{285}{Trigram模型基于词频估计条件概率。以“请／先”为历史，其出现100次，其中后接“登录”65次、后接“登陆”3次，对应概率分别为0.65和0.03；“先／登录”后接“账号”的概率为0.8。图中数据均为假设值。}{figure.caption.181}{}}
\newlabel{fig:ngram_count@cref}{{[figure][4][20]20.4}{[1][284][]285}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {20.1.3}N-gram的局限}{285}{subsection.20.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20.5}{\ignorespaces N-gram语言模型的数据稀疏问题。随着$n$增大，可能的token组合数量迅速增长，而训练语料只能覆盖其中一部分。绿色方格表示已观察到的组合，空白方格表示未观察到的组合，方格比例仅作示意。}}{285}{figure.caption.182}\protected@file@percent }
\newlabel{fig:ngram_sparsity}{{20.5}{285}{N-gram语言模型的数据稀疏问题。随着$n$增大，可能的token组合数量迅速增长，而训练语料只能覆盖其中一部分。绿色方格表示已观察到的组合，空白方格表示未观察到的组合，方格比例仅作示意。}{figure.caption.182}{}}
\newlabel{fig:ngram_sparsity@cref}{{[figure][5][20]20.5}{[1][285][]285}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.6}{\ignorespaces N-gram模型对相似表达的独立统计。以“请／先／登录”为历史，展示后接“账号”“系统”“平台”时，token组合分别出现较多、较少和未出现的情况。模型主要依赖各自的出现次数估计概率，图中数据均为假设值。}}{286}{figure.caption.183}\protected@file@percent }
\newlabel{fig:ngram_sparsity_example}{{20.6}{286}{N-gram模型对相似表达的独立统计。以“请／先／登录”为历史，展示后接“账号”“系统”“平台”时，token组合分别出现较多、较少和未出现的情况。模型主要依赖各自的出现次数估计概率，图中数据均为假设值。}{figure.caption.183}{}}
\newlabel{fig:ngram_sparsity_example@cref}{{[figure][6][20]20.6}{[1][286][]286}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {20.2}神经网络语言模型}{286}{section.20.2}\protected@file@percent }
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {20.2.1}前馈语言模型}{287}{subsection.20.2.1}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.7}{\ignorespaces 前馈神经网络语言模型的计算过程。历史token的嵌入向量按顺序拼接为输入向量$\mathbf  z_t$，经过隐藏层的线性变换与非线性激活得到$\mathbf  h_t$，再通过输出层计算Logits，最后利用Softmax得到下一个token的概率分布。图中$d$、$d_h$和$V$分别表示嵌入维度、隐藏层维度和词表大小。}}{288}{figure.caption.184}\protected@file@percent }
\newlabel{fig:nnlm_ffn}{{20.7}{288}{前馈神经网络语言模型的计算过程。历史token的嵌入向量按顺序拼接为输入向量$\mathbf z_t$，经过隐藏层的线性变换与非线性激活得到$\mathbf h_t$，再通过输出层计算Logits，最后利用Softmax得到下一个token的概率分布。图中$d$、$d_h$和$V$分别表示嵌入维度、隐藏层维度和词表大小。}{figure.caption.184}{}}
\newlabel{fig:nnlm_ffn@cref}{{[figure][7][20]20.7}{[1][288][]288}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {20.2.2}循环语言模型}{289}{subsection.20.2.2}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.8}{\ignorespaces 前馈语言模型与循环语言模型的上下文利用方式对比。左侧的前馈网络每次只使用固定窗口内的历史token进行预测，忽略窗口之外的信息；右侧的RNN依次读取token，通过隐藏状态不断传递和积累历史信息，并利用当前状态预测下一个token的概率分布。}}{290}{figure.caption.185}\protected@file@percent }
\newlabel{fig:nnlm_rnn}{{20.8}{290}{前馈语言模型与循环语言模型的上下文利用方式对比。左侧的前馈网络每次只使用固定窗口内的历史token进行预测，忽略窗口之外的信息；右侧的RNN依次读取token，通过隐藏状态不断传递和积累历史信息，并利用当前状态预测下一个token的概率分布。}{figure.caption.185}{}}
\newlabel{fig:nnlm_rnn@cref}{{[figure][8][20]20.8}{[1][290][]290}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {20.2.3}神经网络语言模型的训练}{290}{subsection.20.2.3}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {20.9}{\ignorespaces 神经网络语言模型的训练过程。输入序列与目标序列错开一个token，模型根据真实的历史token预测下一个token，并利用各个位置的预测结果与真实目标计算训练损失。}}{291}{figure.caption.186}\protected@file@percent }
\newlabel{fig:nnlm_train}{{20.9}{291}{神经网络语言模型的训练过程。输入序列与目标序列错开一个token，模型根据真实的历史token预测下一个token，并利用各个位置的预测结果与真实目标计算训练损失。}{figure.caption.186}{}}
\newlabel{fig:nnlm_train@cref}{{[figure][9][20]20.9}{[1][291][]291}{}{}{}}
