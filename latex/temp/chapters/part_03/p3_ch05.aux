\def\@LN@column{1}
\@writefile{toc}{\contentsline {chapter}{\numberline {15}Seq2Seq}{201}{chapter.15}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{lof}{\contentsline {figure}{\numberline {15.1}{\ignorespaces RNN的基本单元与典型序列任务结构。左：RNN单元结合当前输入$x_t$与上一隐藏状态$h_{t-1}$算出$h_t$；右：两种任务结构——多对一在读完序列后由最终状态$h_T$生成单个输出，同步多对多则在每个时间步由$h_t$生成对应输出、与输入逐步对齐。}}{201}{figure.caption.135}\protected@file@percent }
\newlabel{fig:rnn_structures}{{15.1}{201}{RNN的基本单元与典型序列任务结构。左：RNN单元结合当前输入$x_t$与上一隐藏状态$h_{t-1}$算出$h_t$；右：两种任务结构——多对一在读完序列后由最终状态$h_T$生成单个输出，同步多对多则在每个时间步由$h_t$生成对应输出、与输入逐步对齐。}{figure.caption.135}{}}
\newlabel{fig:rnn_structures@cref}{{[figure][1][15]15.1}{[1][201][]201}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15.2}{\ignorespaces 翻译任务。两个中译英示例：左例源端11字对应目标端7词，右例14字对应8词，输入与输出长度不等（$T\neq  S$）；虚线为词级对应关系，左例大致顺序对齐，右例交叉错开。}}{202}{figure.caption.136}\protected@file@percent }
\newlabel{fig:translation_mission}{{15.2}{202}{翻译任务。两个中译英示例：左例源端11字对应目标端7词，右例14字对应8词，输入与输出长度不等（$T\neq S$）；虚线为词级对应关系，左例大致顺序对齐，右例交叉错开。}{figure.caption.136}{}}
\newlabel{fig:translation_mission@cref}{{[figure][2][15]15.2}{[1][202][]202}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15.3}{\ignorespaces 编码器—解码器（Encoder-Decoder）架构。左侧编码器RNN依次读入源序列$x_1,\ldots  ,x_T$，将信息压缩进最终隐藏状态$h_T$；该状态传入右侧解码器，解码器RNN以其为起点自回归地逐步生成目标序列$y_1,\ldots  ,y_S$，即前一步生成的词作为下一步输入。两序列长度$T$与$S$不必相等。}}{203}{figure.caption.137}\protected@file@percent }
\newlabel{fig:encoder_decoder}{{15.3}{203}{编码器—解码器（Encoder-Decoder）架构。左侧编码器RNN依次读入源序列$x_1,\ldots ,x_T$，将信息压缩进最终隐藏状态$h_T$；该状态传入右侧解码器，解码器RNN以其为起点自回归地逐步生成目标序列$y_1,\ldots ,y_S$，即前一步生成的词作为下一步输入。两序列长度$T$与$S$不必相等。}{figure.caption.137}{}}
\newlabel{fig:encoder_decoder@cref}{{[figure][3][15]15.3}{[1][202][]203}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {15.1}Encoder}{203}{section.15.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15.4}{\ignorespaces 编码器沿时间方向展开。词向量$x_1,\ldots  ,x_T$依次进入参数共享的同一RNN单元，隐藏状态自$h_0$逐步右传为$h_1,\ldots  ,h_T$；读入过程不产生输出，全部信息浓缩进高亮的$h_T$交给下一模块。单元可替换为LSTM/GRU。}}{203}{figure.caption.138}\protected@file@percent }
\newlabel{fig:seq2seq_encoder}{{15.4}{203}{编码器沿时间方向展开。词向量$x_1,\ldots ,x_T$依次进入参数共享的同一RNN单元，隐藏状态自$h_0$逐步右传为$h_1,\ldots ,h_T$；读入过程不产生输出，全部信息浓缩进高亮的$h_T$交给下一模块。单元可替换为LSTM/GRU。}{figure.caption.138}{}}
\newlabel{fig:seq2seq_encoder@cref}{{[figure][4][15]15.4}{[1][203][]203}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {15.2}Decoder}{204}{section.15.2}\protected@file@percent }
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15.5}{\ignorespaces 解码器逐步生成目标序列示意图。上下文向量$c$作为初始状态$s_0$；首个时间步输入启动标记$\langle \mathrm  {SOS}\rangle $计算$s_1$并生成$y_1$。此后，每一步将上一步生成的词作为输入，结合上一隐藏状态计算并预测下一个词，直至生成结束标记$\langle \mathrm  {EOS}\rangle $终止。}}{206}{figure.caption.139}\protected@file@percent }
\newlabel{fig:seq2seq_decoder}{{15.5}{206}{解码器逐步生成目标序列示意图。上下文向量$c$作为初始状态$s_0$；首个时间步输入启动标记$\langle \mathrm {SOS}\rangle $计算$s_1$并生成$y_1$。此后，每一步将上一步生成的词作为输入，结合上一隐藏状态计算并预测下一个词，直至生成结束标记$\langle \mathrm {EOS}\rangle $终止。}{figure.caption.139}{}}
\newlabel{fig:seq2seq_decoder@cref}{{[figure][5][15]15.5}{[1][206][]206}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15.6}{\ignorespaces Seq2Seq（编码器—解码器）完整架构。编码器依次读入源序列$x_1,\ldots  ,x_T$，将最终隐藏状态$h_T$作为上下文向量$c$，用于初始化解码器状态$s_0$。解码器以$\langle \mathrm  {SOS}\rangle $为起点，将上一步生成的词作为下一步输入，经输出层与Softmax逐步生成目标序列，直到输出$\langle \mathrm  {EOS}\rangle $。编码器与解码器使用各自的参数，输入与输出长度$T$和$S$可以不同。图中以普通RNN为例，也可替换为LSTM或GRU。}}{207}{figure.caption.140}\protected@file@percent }
\newlabel{fig:seq2seq_full}{{15.6}{207}{Seq2Seq（编码器—解码器）完整架构。编码器依次读入源序列$x_1,\ldots ,x_T$，将最终隐藏状态$h_T$作为上下文向量$c$，用于初始化解码器状态$s_0$。解码器以$\langle \mathrm {SOS}\rangle $为起点，将上一步生成的词作为下一步输入，经输出层与Softmax逐步生成目标序列，直到输出$\langle \mathrm {EOS}\rangle $。编码器与解码器使用各自的参数，输入与输出长度$T$和$S$可以不同。图中以普通RNN为例，也可替换为LSTM或GRU。}{figure.caption.140}{}}
\newlabel{fig:seq2seq_full@cref}{{[figure][6][15]15.6}{[1][207][]207}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {15.3}Seq2Seq的训练}{208}{section.15.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15.7}{\ignorespaces 教师强制的工作原理。左图使用模型自身的预测作为下一步输入，错误预测可能影响后续步骤；右图始终使用目标序列中的真实词作为下一步输入，并将每一步的预测与对应的正确目标进行比较、计算损失。解码器输入为目标序列右移一位后，在开头添加启动标记$\langle \mathrm  {SOS}\rangle $。}}{208}{figure.caption.141}\protected@file@percent }
\newlabel{fig:seq2seq_teacher_forcing}{{15.7}{208}{教师强制的工作原理。左图使用模型自身的预测作为下一步输入，错误预测可能影响后续步骤；右图始终使用目标序列中的真实词作为下一步输入，并将每一步的预测与对应的正确目标进行比较、计算损失。解码器输入为目标序列右移一位后，在开头添加启动标记$\langle \mathrm {SOS}\rangle $。}{figure.caption.141}{}}
\newlabel{fig:seq2seq_teacher_forcing@cref}{{[figure][7][15]15.7}{[1][208][]208}{}{}{}}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15.8}{\ignorespaces 暴露偏差示意图。左侧为训练阶段，解码器使用真实目标词作为下一步输入；右侧为推理阶段，解码器只能使用自身生成的词，早期预测错误可能沿后续时间步传播，导致训练与推理之间产生差异。}}{210}{figure.caption.142}\protected@file@percent }
\newlabel{fig:seq2seq_train_infer}{{15.8}{210}{暴露偏差示意图。左侧为训练阶段，解码器使用真实目标词作为下一步输入；右侧为推理阶段，解码器只能使用自身生成的词，早期预测错误可能沿后续时间步传播，导致训练与推理之间产生差异。}{figure.caption.142}{}}
\newlabel{fig:seq2seq_train_infer@cref}{{[figure][8][15]15.8}{[1][210][]210}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {15.4}Seq2Seq的局限}{210}{section.15.4}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15.9}{\ignorespaces Seq2Seq的信息瓶颈。无论输入序列有多长，编码器最终都将其压缩为维度相同的上下文向量$c\in \mathbb  {R}^{n}$。随着输入长度增加，单个向量需要承载的信息越来越多，难以充分保留所有细节。}}{211}{figure.caption.143}\protected@file@percent }
\newlabel{fig:seq2seq_context}{{15.9}{211}{Seq2Seq的信息瓶颈。无论输入序列有多长，编码器最终都将其压缩为维度相同的上下文向量$c\in \mathbb {R}^{n}$。随着输入长度增加，单个向量需要承载的信息越来越多，难以充分保留所有细节。}{figure.caption.143}{}}
\newlabel{fig:seq2seq_context@cref}{{[figure][9][15]15.9}{[1][211][]211}{}{}{}}
