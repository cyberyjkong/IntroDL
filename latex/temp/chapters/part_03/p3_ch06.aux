\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {16.1.3}加权求和}{216}{subsection.16.1.3}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16.2}{\ignorespaces 加性注意力机制的计算流程。对于解码器上一时刻的隐藏状态$s_{t-1}$与编码器各位置的隐藏状态$H$，模型先分别进行线性变换并相加，通过激活函数与点积计算注意力分数$\boldsymbol  {e}_t$；随后经Softmax归一化得到权重$\boldsymbol  {\alpha }_t$，对$H$加权求和获得上下文向量$\boldsymbol  {c}_t$。在后续生成步骤中，该注意力计算会随解码状态动态更新。}}{217}{figure.caption.145}\protected@file@percent }
\newlabel{fig:additive_attention}{{16.2}{217}{加性注意力机制的计算流程。对于解码器上一时刻的隐藏状态$s_{t-1}$与编码器各位置的隐藏状态$H$，模型先分别进行线性变换并相加，通过激活函数与点积计算注意力分数$\boldsymbol {e}_t$；随后经Softmax归一化得到权重$\boldsymbol {\alpha }_t$，对$H$加权求和获得上下文向量$\boldsymbol {c}_t$。在后续生成步骤中，该注意力计算会随解码状态动态更新。}{figure.caption.145}{}}
\newlabel{fig:additive_attention@cref}{{[figure][2][16]16.2}{[1][216][]217}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {16.2}解码生成}{218}{section.16.2}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16.3}{\ignorespaces 普通与带注意力机制的Seq2Seq解码单元对比。左侧由$s_{t-1}$和$y_{t-1}$更新状态并预测，编码信息固定传入；右侧动态计算$c_t$更新$s_t$，拼接后预测$y_t$，动态利用输入信息。}}{219}{figure.caption.146}\protected@file@percent }
\newlabel{fig:decoder_comparison}{{16.3}{219}{普通与带注意力机制的Seq2Seq解码单元对比。左侧由$s_{t-1}$和$y_{t-1}$更新状态并预测，编码信息固定传入；右侧动态计算$c_t$更新$s_t$，拼接后预测$y_t$，动态利用输入信息。}{figure.caption.146}{}}
\newlabel{fig:decoder_comparison@cref}{{[figure][3][16]16.3}{[1][218][]219}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16.4}{\ignorespaces 普通与带注意力机制的Seq2Seq解码器对比。普通解码器将编码器最终状态作为固定输入，仅利用隐藏状态预测输出；带注意力的解码器在每步利用$h_{t-1}$与编码状态计算分数并经Softmax得权重$\alpha _{ti}$，加权得$c_t$，结合前一状态与$c_t$更新$h_t$并预测$\hat  {y}_t$，动态聚焦输入信息，直至生成结束标记。}}{219}{figure.caption.147}\protected@file@percent }
\newlabel{fig:attention_seq2seq_decoder}{{16.4}{219}{普通与带注意力机制的Seq2Seq解码器对比。普通解码器将编码器最终状态作为固定输入，仅利用隐藏状态预测输出；带注意力的解码器在每步利用$h_{t-1}$与编码状态计算分数并经Softmax得权重$\alpha _{ti}$，加权得$c_t$，结合前一状态与$c_t$更新$h_t$并预测$\hat {y}_t$，动态聚焦输入信息，直至生成结束标记。}{figure.caption.147}{}}
\newlabel{fig:attention_seq2seq_decoder@cref}{{[figure][4][16]16.4}{[1][219][]219}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16.5}{\ignorespaces 注意力权重矩阵与输入输出对齐。以“我喜欢吃又大又红的苹果”到“\emph  {I like to eat big red apples}”的翻译为例，横轴表示输入词语，纵轴表示输出单词。}}{220}{figure.caption.148}\protected@file@percent }
\newlabel{fig:attention_matrix}{{16.5}{220}{注意力权重矩阵与输入输出对齐。以“我喜欢吃又大又红的苹果”到“\emph {I like to eat big red apples}”的翻译为例，横轴表示输入词语，纵轴表示输出单词。}{figure.caption.148}{}}
\newlabel{fig:attention_matrix@cref}{{[figure][5][16]16.5}{[1][220][]220}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {16.3}点积注意力}{221}{section.16.3}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16.6}{\ignorespaces 点积注意力的计算流程。解码器隐藏状态$s_{t-1}$分别与编码器隐藏状态$h_i$计算点积，得到注意力分数$e_{t,i}$。分数经Softmax得到注意力权重$\alpha _{t,i}$，再对编码器隐藏状态加权求和，得到上下文向量$c_t$。}}{222}{figure.caption.149}\protected@file@percent }
\newlabel{fig:dot_product_attention}{{16.6}{222}{点积注意力的计算流程。解码器隐藏状态$s_{t-1}$分别与编码器隐藏状态$h_i$计算点积，得到注意力分数$e_{t,i}$。分数经Softmax得到注意力权重$\alpha _{t,i}$，再对编码器隐藏状态加权求和，得到上下文向量$c_t$。}{figure.caption.149}{}}
\newlabel{fig:dot_product_attention@cref}{{[figure][6][16]16.6}{[1][222][]222}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16.7}{\ignorespaces 加性注意力（左）与点积注意力（右）计算注意力分数对比。加性注意力通过权重矩阵$W_s$、$W_h$及非线性函数$\tanh $计算；点积注意力直接计算$s_{t-1}^\top h_i$。}}{223}{figure.caption.150}\protected@file@percent }
\newlabel{fig:additive_dot_product}{{16.7}{223}{加性注意力（左）与点积注意力（右）计算注意力分数对比。加性注意力通过权重矩阵$W_s$、$W_h$及非线性函数$\tanh $计算；点积注意力直接计算$s_{t-1}^\top h_i$。}{figure.caption.150}{}}
\newlabel{fig:additive_dot_product@cref}{{[figure][7][16]16.7}{[1][223][]223}{}{}{}}
\def\@LN@column{1}
