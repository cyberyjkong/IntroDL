\@writefile{toc}{\contentsline {section}{\numberline {16.1}加性注意力}{213}{section.16.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16.1}{\ignorespaces 注意力分数示意图。编码器依次处理输入序列，得到隐藏状态$h_1,h_2,\ldots  ,h_T$。在生成当前输出词$y_t$时，解码器分别为各个隐藏状态计算注意力分数。图中不同位置对应不同的分数，其中分数较高的位置会受到更多关注。图中的数值仅用于示意。}}{213}{figure.caption.144}\protected@file@percent }
\newlabel{fig:attention_score}{{16.1}{213}{注意力分数示意图。编码器依次处理输入序列，得到隐藏状态$h_1,h_2,\ldots ,h_T$。在生成当前输出词$y_t$时，解码器分别为各个隐藏状态计算注意力分数。图中不同位置对应不同的分数，其中分数较高的位置会受到更多关注。图中的数值仅用于示意。}{figure.caption.144}{}}
\newlabel{fig:attention_score@cref}{{[figure][1][16]16.1}{[1][213][]213}{}{}{}}
