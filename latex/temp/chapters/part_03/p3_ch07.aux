\def\@LN@column{1}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17.6}{\ignorespaces BN与LN的归一化方式对比。输入张量包含批次（Batch）、序列长度（Sequence Length）和特征（Feature）三个维度，彩色区域表示计算均值和方差时所涉及的数据范围。BN固定特征维度，在不同样本和序列位置之间计算统计量；LN则固定样本和序列位置，沿特征维度独立计算均值和方差。}}{245}{figure.caption.158}\protected@file@percent }
\newlabel{fig:layernorm}{{17.6}{245}{BN与LN的归一化方式对比。输入张量包含批次（Batch）、序列长度（Sequence Length）和特征（Feature）三个维度，彩色区域表示计算均值和方差时所涉及的数据范围。BN固定特征维度，在不同样本和序列位置之间计算统计量；LN则固定样本和序列位置，沿特征维度独立计算均值和方差。}{figure.caption.158}{}}
\newlabel{fig:layernorm@cref}{{[figure][6][17]17.6}{[1][245][]245}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {17.4}前馈神经网络}{246}{section.17.4}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17.7}{\ignorespaces 前馈神经网络的结构示意图。输入序列中的每个位置分别经过两个全连接层及ReLU激活函数，特征维度由512扩展至2048，再映射回512。各位置独立计算并共享相同的网络参数，最终输出矩阵与输入保持相同的形状。}}{247}{figure.caption.159}\protected@file@percent }
\newlabel{fig:feed_forward}{{17.7}{247}{前馈神经网络的结构示意图。输入序列中的每个位置分别经过两个全连接层及ReLU激活函数，特征维度由512扩展至2048，再映射回512。各位置独立计算并共享相同的网络参数，最终输出矩阵与输入保持相同的形状。}{figure.caption.159}{}}
\newlabel{fig:feed_forward@cref}{{[figure][7][17]17.7}{[1][247][]247}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17.8}{\ignorespaces Transformer Encoder结构图。输入序列经过词嵌入和位置编码后，依次通过$N$个结构相同的编码器层。每层包含多头自注意力和前馈神经网络两个子层，并分别经过Add \& Norm处理，最终得到包含上下文信息的序列表示$H$。}}{248}{figure.caption.160}\protected@file@percent }
\newlabel{fig:transformer_encoder}{{17.8}{248}{Transformer Encoder结构图。输入序列经过词嵌入和位置编码后，依次通过$N$个结构相同的编码器层。每层包含多头自注意力和前馈神经网络两个子层，并分别经过Add \& Norm处理，最终得到包含上下文信息的序列表示$H$。}{figure.caption.160}{}}
\newlabel{fig:transformer_encoder@cref}{{[figure][8][17]17.8}{[1][248][]248}{}{}{}}
