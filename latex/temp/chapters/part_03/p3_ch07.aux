\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{lof}{\contentsline {figure}{\numberline {17.1}{\ignorespaces Transformer架构图。模型由编码器和解码器组成，二者均由$N$个结构相同的网络层堆叠而成。编码器以多头自注意力和前馈网络提取输入上下文特征；解码器结合编码器输出，再逐步地生成目标序列。}}{231}{figure.caption.153}\protected@file@percent }
\newlabel{fig:transformer}{{17.1}{231}{Transformer架构图。模型由编码器和解码器组成，二者均由$N$个结构相同的网络层堆叠而成。编码器以多头自注意力和前馈网络提取输入上下文特征；解码器结合编码器输出，再逐步地生成目标序列。}{figure.caption.153}{}}
\newlabel{fig:transformer@cref}{{[figure][1][17]17.1}{[1][231][]231}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17.2}{\ignorespaces Transformer序列计算展开图。$PE$为位置编码，$MHA$为多头注意力。左侧编码器通过自注意力与前馈网络提取输入特征；右侧解码器结合Masked MHA与Cross MHA，经线性层预测下一词。黄色虚线表示推理阶段的自回归生成，即逐步将生成词作为下一步输入直至结束。}}{232}{figure.caption.154}\protected@file@percent }
\newlabel{fig:transformer_seq2seq}{{17.2}{232}{Transformer序列计算展开图。$PE$为位置编码，$MHA$为多头注意力。左侧编码器通过自注意力与前馈网络提取输入特征；右侧解码器结合Masked MHA与Cross MHA，经线性层预测下一词。黄色虚线表示推理阶段的自回归生成，即逐步将生成词作为下一步输入直至结束。}{figure.caption.154}{}}
\newlabel{fig:transformer_seq2seq@cref}{{[figure][2][17]17.2}{[1][232][]232}{}{}{}}
