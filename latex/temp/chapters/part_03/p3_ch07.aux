\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17.3}{\ignorespaces 正弦余弦位置编码的旋转变换示意图。左右两图展示不同起始位置下的向量变化。对于同一组维度，相同的位置间隔$k$对应相同的旋转角度$\Delta \theta =\omega _i k$，说明这一变换只与相对距离有关，而不依赖位置。}}{238}{figure.caption.155}\protected@file@percent }
\newlabel{fig:positional_encoding}{{17.3}{238}{正弦余弦位置编码的旋转变换示意图。左右两图展示不同起始位置下的向量变化。对于同一组维度，相同的位置间隔$k$对应相同的旋转角度$\Delta \theta =\omega _i k$，说明这一变换只与相对距离有关，而不依赖位置。}{figure.caption.155}{}}
\newlabel{fig:positional_encoding@cref}{{[figure][3][17]17.3}{[1][238][]238}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {17.2}多头自注意力机制}{239}{section.17.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.4}{\ignorespaces 多头注意力机制的整体结构。输入Query、Key和Value经过多组独立的线性变换，分别送入不同的注意力头计算，再将各头输出拼接并进行线性变换，得到最终结果。}}{239}{figure.caption.156}\protected@file@percent }
\newlabel{fig:mha}{{17.4}{239}{多头注意力机制的整体结构。输入Query、Key和Value经过多组独立的线性变换，分别送入不同的注意力头计算，再将各头输出拼接并进行线性变换，得到最终结果。}{figure.caption.156}{}}
\newlabel{fig:mha@cref}{{[figure][4][17]17.4}{[1][239][]239}{}{}{}}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17.5}{\ignorespaces 多头注意力机制的矩阵计算流程。输入经过Query、Key和Value投影，再沿特征维度划分为多个注意力头。各头通过Query和Key计算注意力分数，经缩放与Softmax归一化得到权重，并对Value加权求和。最后，将各头输出拼接，通过输出投影矩阵$W^O$进行线性变换，得到与输入维度一致的结果。}}{241}{figure.caption.157}\protected@file@percent }
\newlabel{fig:multi_head_attention}{{17.5}{241}{多头注意力机制的矩阵计算流程。输入经过Query、Key和Value投影，再沿特征维度划分为多个注意力头。各头通过Query和Key计算注意力分数，经缩放与Softmax归一化得到权重，并对Value加权求和。最后，将各头输出拼接，通过输出投影矩阵$W^O$进行线性变换，得到与输入维度一致的结果。}{figure.caption.157}{}}
\newlabel{fig:multi_head_attention@cref}{{[figure][5][17]17.5}{[1][240][]241}{}{}{}}
