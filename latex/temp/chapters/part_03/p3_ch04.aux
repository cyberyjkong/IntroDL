\@writefile{toc}{\contentsline {chapter}{\numberline {14}Seq2Seq}{185}{chapter.14}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{lof}{\contentsline {figure}{\numberline {14.1}{\ignorespaces RNN的基本单元与典型序列任务结构。左：RNN单元结合当前输入$x_t$与上一隐藏状态$h_{t-1}$算出$h_t$；右：两种任务结构——多对一在读完序列后由最终状态$h_T$生成单个输出，同步多对多则在每个时间步由$h_t$生成对应输出、与输入逐步对齐。}}{185}{figure.caption.127}\protected@file@percent }
\newlabel{fig:rnn_structures}{{14.1}{185}{RNN的基本单元与典型序列任务结构。左：RNN单元结合当前输入$x_t$与上一隐藏状态$h_{t-1}$算出$h_t$；右：两种任务结构——多对一在读完序列后由最终状态$h_T$生成单个输出，同步多对多则在每个时间步由$h_t$生成对应输出、与输入逐步对齐。}{figure.caption.127}{}}
\newlabel{fig:rnn_structures@cref}{{[figure][1][14]14.1}{[1][185][]185}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.2}{\ignorespaces 翻译任务。两个中译英示例：左例源端11字对应目标端7词，右例14字对应8词，输入与输出长度不等（$T\neq  S$）；虚线为词级对应关系，左例大致顺序对齐，右例交叉错开。}}{186}{figure.caption.128}\protected@file@percent }
\newlabel{fig:translation_mission}{{14.2}{186}{翻译任务。两个中译英示例：左例源端11字对应目标端7词，右例14字对应8词，输入与输出长度不等（$T\neq S$）；虚线为词级对应关系，左例大致顺序对齐，右例交叉错开。}{figure.caption.128}{}}
\newlabel{fig:translation_mission@cref}{{[figure][2][14]14.2}{[1][186][]186}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.3}{\ignorespaces 编码器—解码器（Encoder-Decoder）架构。左侧编码器RNN依次读入源序列$x_1,\ldots  ,x_T$，将信息压缩进最终隐藏状态$h_T$；该状态传入右侧解码器，解码器RNN以其为起点自回归地逐步生成目标序列$y_1,\ldots  ,y_S$，即前一步生成的词作为下一步输入。两序列长度$T$与$S$不必相等。}}{187}{figure.caption.129}\protected@file@percent }
\newlabel{fig:encoder_decoder}{{14.3}{187}{编码器—解码器（Encoder-Decoder）架构。左侧编码器RNN依次读入源序列$x_1,\ldots ,x_T$，将信息压缩进最终隐藏状态$h_T$；该状态传入右侧解码器，解码器RNN以其为起点自回归地逐步生成目标序列$y_1,\ldots ,y_S$，即前一步生成的词作为下一步输入。两序列长度$T$与$S$不必相等。}{figure.caption.129}{}}
\newlabel{fig:encoder_decoder@cref}{{[figure][3][14]14.3}{[1][186][]187}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {14.1}Encoder}{187}{section.14.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14.4}{\ignorespaces 编码器沿时间方向展开。词向量$x_1,\ldots  ,x_T$依次进入参数共享的同一RNN单元，隐藏状态自$h_0$逐步右传为$h_1,\ldots  ,h_T$；读入过程不产生输出，全部信息浓缩进高亮的$h_T$交给下一模块。单元可替换为LSTM/GRU。}}{187}{figure.caption.130}\protected@file@percent }
\newlabel{fig:seq2seq_encoder}{{14.4}{187}{编码器沿时间方向展开。词向量$x_1,\ldots ,x_T$依次进入参数共享的同一RNN单元，隐藏状态自$h_0$逐步右传为$h_1,\ldots ,h_T$；读入过程不产生输出，全部信息浓缩进高亮的$h_T$交给下一模块。单元可替换为LSTM/GRU。}{figure.caption.130}{}}
\newlabel{fig:seq2seq_encoder@cref}{{[figure][4][14]14.4}{[1][187][]187}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {14.2}Decoder}{188}{section.14.2}\protected@file@percent }
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.5}{\ignorespaces 解码器逐步生成目标序列示意图。上下文向量$c$作为初始状态$s_0$；首个时间步输入启动标记$\langle \mathrm  {SOS}\rangle $计算$s_1$并生成$y_1$。此后，每一步将上一步生成的词作为输入，结合上一隐藏状态计算并预测下一个词，直至生成结束标记$\langle \mathrm  {EOS}\rangle $终止。}}{190}{figure.caption.131}\protected@file@percent }
\newlabel{fig:seq2seq_decoder}{{14.5}{190}{解码器逐步生成目标序列示意图。上下文向量$c$作为初始状态$s_0$；首个时间步输入启动标记$\langle \mathrm {SOS}\rangle $计算$s_1$并生成$y_1$。此后，每一步将上一步生成的词作为输入，结合上一隐藏状态计算并预测下一个词，直至生成结束标记$\langle \mathrm {EOS}\rangle $终止。}{figure.caption.131}{}}
\newlabel{fig:seq2seq_decoder@cref}{{[figure][5][14]14.5}{[1][190][]190}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.6}{\ignorespaces Seq2Seq（编码器—解码器）完整架构。编码器依次读入源序列$x_1,\ldots  ,x_T$，将最终隐藏状态$h_T$作为上下文向量$c$，用于初始化解码器状态$s_0$。解码器以$\langle \mathrm  {SOS}\rangle $为起点，将上一步生成的词作为下一步输入，经输出层与Softmax逐步生成目标序列，直到输出$\langle \mathrm  {EOS}\rangle $。编码器与解码器使用各自的参数，输入与输出长度$T$和$S$可以不同。图中以普通RNN为例，也可替换为LSTM或GRU。}}{191}{figure.caption.132}\protected@file@percent }
\newlabel{fig:seq2seq_full}{{14.6}{191}{Seq2Seq（编码器—解码器）完整架构。编码器依次读入源序列$x_1,\ldots ,x_T$，将最终隐藏状态$h_T$作为上下文向量$c$，用于初始化解码器状态$s_0$。解码器以$\langle \mathrm {SOS}\rangle $为起点，将上一步生成的词作为下一步输入，经输出层与Softmax逐步生成目标序列，直到输出$\langle \mathrm {EOS}\rangle $。编码器与解码器使用各自的参数，输入与输出长度$T$和$S$可以不同。图中以普通RNN为例，也可替换为LSTM或GRU。}{figure.caption.132}{}}
\newlabel{fig:seq2seq_full@cref}{{[figure][6][14]14.6}{[1][191][]191}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {14.3}Seq2Seq的训练}{192}{section.14.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14.7}{\ignorespaces 教师强制的工作原理。左图使用模型自身的预测作为下一步输入，错误预测可能影响后续步骤；右图始终使用目标序列中的真实词作为下一步输入，并将每一步的预测与对应的正确目标进行比较、计算损失。解码器输入为目标序列右移一位后，在开头添加启动标记$\langle \mathrm  {SOS}\rangle $。}}{192}{figure.caption.133}\protected@file@percent }
\newlabel{fig:seq2seq_teacher_forcing}{{14.7}{192}{教师强制的工作原理。左图使用模型自身的预测作为下一步输入，错误预测可能影响后续步骤；右图始终使用目标序列中的真实词作为下一步输入，并将每一步的预测与对应的正确目标进行比较、计算损失。解码器输入为目标序列右移一位后，在开头添加启动标记$\langle \mathrm {SOS}\rangle $。}{figure.caption.133}{}}
\newlabel{fig:seq2seq_teacher_forcing@cref}{{[figure][7][14]14.7}{[1][192][]192}{}{}{}}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.8}{\ignorespaces 暴露偏差示意图。左侧为训练阶段，解码器使用真实目标词作为下一步输入；右侧为推理阶段，解码器只能使用自身生成的词，早期预测错误可能沿后续时间步传播，导致训练与推理之间产生差异。}}{194}{figure.caption.134}\protected@file@percent }
\newlabel{fig:seq2seq_train_infer}{{14.8}{194}{暴露偏差示意图。左侧为训练阶段，解码器使用真实目标词作为下一步输入；右侧为推理阶段，解码器只能使用自身生成的词，早期预测错误可能沿后续时间步传播，导致训练与推理之间产生差异。}{figure.caption.134}{}}
\newlabel{fig:seq2seq_train_infer@cref}{{[figure][8][14]14.8}{[1][194][]194}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {14.4}Seq2Seq的局限}{194}{section.14.4}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.9}{\ignorespaces Seq2Seq的信息瓶颈。无论输入序列有多长，编码器最终都将其压缩为维度相同的上下文向量$c\in \mathbb  {R}^{n}$。随着输入长度增加，单个向量需要承载的信息越来越多，难以充分保留所有细节。}}{195}{figure.caption.135}\protected@file@percent }
\newlabel{fig:seq2seq_context}{{14.9}{195}{Seq2Seq的信息瓶颈。无论输入序列有多长，编码器最终都将其压缩为维度相同的上下文向量$c\in \mathbb {R}^{n}$。随着输入长度增加，单个向量需要承载的信息越来越多，难以充分保留所有细节。}{figure.caption.135}{}}
\newlabel{fig:seq2seq_context@cref}{{[figure][9][14]14.9}{[1][194][]195}{}{}{}}
