\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14.10}{\ignorespaces 固定向量瓶颈与 Attention 的伏笔。图左侧画编码器读入一个较长的源句子（例如 10 个词），从每个词出发的众多箭头拥挤地汇入中间一个画成沙漏颈部的狭窄通道，通道上标注 $c$，并用红色文字注明句子越长，瓶颈越吃力，早期信息越容易丢失。图右侧画解码器：它生成第 1 个词、第 10 个词时依赖的都是同一个固定不变的 $c$，用两条指向同一方块 $c$ 的箭头强调一成不变。图旁另画一个虚线对照网络：解码器在生成每个词时，直接伸出若干条粗细不同的连线回看编码器的全部隐藏状态$h_1, \dots  , h_T$，连线粗细表示关注程度，用绿色标注动态查阅，表示打破瓶颈的设想——即Attention 机制。该图的核心目的是让读者意识到把所有信息压进一个固定向量是 Seq2Seq 的根本局限，并为下一章引出注意力机制做好直观铺垫。}}{200}{figure.caption.135}\protected@file@percent }
\newlabel{fig:seq2seq_bottleneck}{{14.10}{200}{固定向量瓶颈与 Attention 的伏笔。图左侧画编码器读入一个较长的源句子（例如 10 个词），从每个词出发的众多箭头拥挤地汇入中间一个画成沙漏颈部的狭窄通道，通道上标注 $c$，并用红色文字注明句子越长，瓶颈越吃力，早期信息越容易丢失。图右侧画解码器：它生成第 1 个词、第 10 个词时依赖的都是同一个固定不变的 $c$，用两条指向同一方块 $c$ 的箭头强调一成不变。图旁另画一个虚线对照网络：解码器在生成每个词时，直接伸出若干条粗细不同的连线回看编码器的全部隐藏状态$h_1, \dots , h_T$，连线粗细表示关注程度，用绿色标注动态查阅，表示打破瓶颈的设想——即Attention 机制。该图的核心目的是让读者意识到把所有信息压进一个固定向量是 Seq2Seq 的根本局限，并为下一章引出注意力机制做好直观铺垫。}{figure.caption.135}{}}
\newlabel{fig:seq2seq_bottleneck@cref}{{[figure][10][14]14.10}{[1][199][]200}{}{}{}}
